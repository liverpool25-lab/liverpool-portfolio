# ─── Supabase (Required for Guestbook Authentication & Persistence) ──────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Site Origin (Required for OAuth redirect callbacks) ─────────────────────
# Set to your production domain when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contact Form Email Delivery (Resend) ────────────────────────────────────
# Obtain your API key from: https://resend.com/api-keys
# Without this key the contact form falls back gracefully to the Gmail compose button.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Gmail address that receives contact form submissions
CONTACT_EMAIL_TO=klivliverpool1@gmail.com

# The sender shown in the From field of delivered emails.
# MUST be from a domain you have verified in your Resend account.
# For testing only, Resend provides: onboarding@resend.dev (only sends to your account email)
CONTACT_EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
